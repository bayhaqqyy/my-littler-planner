{
  "name": "my-little-planner",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/quicksand": "^0.4.1",
    "@supabase/supabase-js": "^2.118.0",
    "babel-preset-expo": "~58.0.0",
    "date-fns": "^4.4.0",
    "expo": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-font": "~58.0.8",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.20",
    "expo-status-bar": "~58.0.3",
    "localforage": "^1.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.3.0",
    "babel-jest": "^29.7.0",
    "esbuild": "^0.28.2",
    "jest": "^29.7.0",
    "playwright": "1.53",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "build:web": "expo export -p web && node scripts/postbuild.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "build:edge": "node scripts/build-edge-domain.mjs"
  },
  "private": true,
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/src/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "babel-jest",
        {
          "presets": [
            "babel-preset-expo"
          ]
        }
      ]
    }
  }
}
