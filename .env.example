# ---- App (public, baked into the web build) ----
# Supabase project → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>
# Web Push public key (generate a pair with: npx web-push generate-vapid-keys)
EXPO_PUBLIC_VAPID_PUBLIC_KEY=<vapid-public-key>
# URL of the send-reminders Edge Function (used by the service worker's "Tunda 5 menit")
EXPO_PUBLIC_SNOOZE_URL=https://<project-ref>.supabase.co/functions/v1/send-reminders

# ---- Docker + Cloudflare Tunnel ----
# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → token
CLOUDFLARE_TUNNEL_TOKEN=<tunnel-token>

# ---- Edge Function secrets (NOT in this file; set with the Supabase CLI) ----
#   npx supabase secrets set VAPID_PUBLIC_KEY=... VAPID_PRIVATE_KEY=... VAPID_SUBJECT=https://<your-site> CRON_SECRET=...
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided to functions automatically.
#
# ---- Vault secrets for the pg_cron job (SQL editor) ----
#   select vault.create_secret('https://<project-ref>.supabase.co', 'project_url');
#   select vault.create_secret('<CRON_SECRET dari .env>', 'cron_secret');
#
# ---- Google login ----
# Supabase → Authentication → Providers → Google: add the Google OAuth client id/secret.
# Supabase → Authentication → URL Configuration: add your site URL(s).

# Public site URL (Supabase Auth Site URL; used by scripts/supabase-setup.mjs)
SITE_URL=https://todo.example.com

# Email sending (Resend SMTP) for verification + reset password — used by scripts/supabase-setup.mjs
RESEND_API_KEY=<re_...>
SMTP_SENDER=noreply@bayhaqqy.my.id

# Google Calendar sync: signs the OAuth "state" (any long random string)
GCAL_STATE_SECRET=<random>
